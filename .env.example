# Copy to .env and fill in. The app reads these at startup.

# Provider: "groq" (hosted, default) or "ollama" (local/offline)
LLM_PROVIDER=groq

# Groq (get a free key at https://console.groq.com)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b
# Optional: add more keys for failover. Requests round-robin across all keys
# and fail over to the next on a rate limit, so one exhausted key never
# takes the app down. Add GROQ_API_KEY_2, GROQ_API_KEY_3, ... as needed.
# GROQ_API_KEY_2=your-second-groq-key
# GROQ_API_KEY_3=your-third-groq-key

# Ollama fallback (only used when LLM_PROVIDER=ollama).
# Local:  ollama pull qwen2.5 && ollama serve   (OLLAMA_API_KEY can stay "ollama")
# Cloud:  set OLLAMA_BASE_URL=https://ollama.com/v1 and put your ollama.com key below.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=qwen2.5

# State + audit store.
# Unset      -> SQLite. Set STATE_DB to a file path to persist locally across restarts
#               (default is in-memory / ephemeral). Reference data is always re-seeded
#               from the workbook, so only escalations + the audit log live here.
# DATABASE_URL set -> Postgres / Supabase (durable, shared across workers). Use the
#               Supabase "session pooler" URI: postgresql://...:6543/postgres
# STATE_DB=data/state.db
# DATABASE_URL=postgresql://postgres.<ref>:<password>@<host>:6543/postgres

# Grounding self-check (default on). GROUNDING_CHECK=0 disables it.
# GROUNDING_THRESHOLD=0.6

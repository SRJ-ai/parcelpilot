# Copy to .env and fill in. The app reads these at startup.

# Provider: "groq" (hosted, default) or "ollama" (local/offline)
LLM_PROVIDER=groq

# Groq (get a free key at https://console.groq.com)
# Add more keys for failover; requests round-robin and fail over on rate limits.
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_MODEL=openai/gpt-oss-120b

# Ollama fallback (only used when LLM_PROVIDER=ollama)
# Run:  ollama pull qwen2.5   then   ollama serve
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5
